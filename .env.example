# Browser-visible: NEXT_PUBLIC_* values are bundled into client JavaScript.
# Use the public anon key here, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Existing requester UUID for account requests; public, not an authorization secret.
NEXT_PUBLIC_ACCOUNT_REQUEST_REQUESTER_ID=your-account-requester-uuid

# Server-only: required only for the scheduled keepalive endpoint.
# Never prefix these with NEXT_PUBLIC_ or expose them in browser code.
CRON_SECRET=your-random-cron-secret
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Existing requester UUID for maintenance tickets (not a key).
MAINTENANCE_REQUESTER_ID=your-maintenance-requester-uuid
